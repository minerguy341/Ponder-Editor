{
 "id": "create:chain_drive/gearshift",
 "schematic": "chain_drive/gearshift",
 "schematicNamespace": "create",
 "title": "Controlling rotational speed with Chain Gearshifts",
 "texts": {
  "text_1": "Unpowered Chain Gearshifts behave exactly like Chain Drives",
  "text_2": "When Powered, the speed transmitted to other Chain Drives in the row is doubled",
  "text_3": "Whenever the Powered Gearshift is not at the source, its speed will be halved instead",
  "text_4": "In both cases, Chain Drives in the row always run at 2x the speed of the Powered Gearshift",
  "text_5": "Using analog signals, the ratio can be adjusted more precisely between 1 and 2",
  "text_6": "12 RPM"
 },
 "tags": [],
 "items": [
  "create:encased_chain_drive",
  "create:adjustable_chain_gearshift"
 ],
