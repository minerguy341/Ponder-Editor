 "id": "create:portable_interface/transfer",
 "schematic": "portable_interface/transfer",
 "schematicNamespace": "create",
 "title": "Contraption Storage Exchange",
 "texts": {
  "text_1": "Moving inventories can be tricky to access with automation.",
  "text_2": "This component can interact with storage without the need to stop the contraption.",
  "text_3": "Place a second one with a gap of 1 or 2 blocks inbetween",
  "text_4": "Whenever they pass by each other, they will engage in a connection",
  "text_5": "While engaged, the stationary interface will represent ALL inventories on the contraption",
  "text_6": "Items can now be inserted...",
  "text_7": "...or extracted from the contraption",
  "text_8": "After no items have been exchanged for a while, the contraption will continue on its way"
 },
