{
 "id": "create:redstone_link",
 "schematic": "redstone_link",
 "schematicNamespace": "create",
 "title": "Using Redstone Links",
 "texts": {
  "text_1": "Redstone Links can transmit redstone signals wirelessly",
  "text_2": "Right-click while Sneaking to toggle receive mode",
  "text_3": "A simple Right-click with a Wrench can do the same",
  "text_4": "Receivers emit the redstone power of transmitters within 256 blocks",
  "text_5": "Placing items in the two slots can specify a Frequency",
  "text_6": "Only the links with matching Frequencies will communicate"
 },
