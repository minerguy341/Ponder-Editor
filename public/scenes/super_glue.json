{
 "id": "create:super_glue",
 "schematic": "super_glue",
 "schematicNamespace": "create",
 "title": "Attaching blocks using Super Glue",
 "texts": {
  "text_1": "Super Glue groups blocks together into moving contraptions",
  "text_2": "Clicking two endpoints creates a new 'glued' area",
  "text_3": "To remove a box, punch it with the glue item in hand",
  "text_4": "Adjacent blocks sharing an area will pull each other along",
  "text_5": "Overlapping glue volumes will move together",
  "text_6": "Blocks hanging on others usually do not require glue"
 },
