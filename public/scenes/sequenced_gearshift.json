{
 "id": "create:sequenced_gearshift",
 "schematic": "sequenced_gearshift",
 "schematicNamespace": "create",
 "title": "Controlling Rotational Speed using Sequenced Gearshifts",
 "texts": {
  "text_1": "Seq. Gearshifts relay rotation by following a timed list of instructions",
  "text_2": "Right-click it to open the Configuration UI",
  "text_3": "Upon receiving a Redstone Signal, it will start running its configured sequence",
  "text_4": "Once finished, it waits for the next Redstone Signal and starts over",
  "text_5": "A redstone comparator can be used to read the current progress"
 },
