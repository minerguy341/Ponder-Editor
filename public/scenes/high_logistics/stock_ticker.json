{
 "id": "create:high_logistics/stock_ticker",
 "schematic": "high_logistics/stock_ticker",
 "schematicNamespace": "create",
 "title": "Ordering items with Stock tickers",
 "texts": {
  "text_1": "Right-click a Stock link before placement to connect to its network",
  "text_2": "Stock-linked packagers make their attached inventory available to the network",
  "text_3": "Stock tickers can order items from these inventories",
  "text_4": "Seated mobs or blaze burners in front of it act as the Stock Keeper",
  "text_5": "Right-click the keeper to start ordering items",
  "text_6": "When an order is submitted, the items will be placed into packages",
  "text_7": "From there, they can be transported to the request point",
  "text_8": "Using attribute or list filters, categories can be added to the item listings",
  "text_9": "Right-click the Stock ticker to open the category editor",
  "text_10": "Stock tickers can also order blocks required for the schematicannon",
  "text_11": "Simply hand the printed clipboard it generated to the Stock keeper"
 },
