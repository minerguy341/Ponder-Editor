{
 "id": "create:high_logistics/package_postbox",
 "schematic": "high_logistics/package_postbox",
 "schematicNamespace": "create",
 "title": "Transporting packages between Postboxes",
 "texts": {
  "text_1": "Right-click a Train Station and place the Postbox nearby",
  "text_2": "Assign it an address in the inventory UI",
  "text_3": "If the address of an inserted package does not match it..",
  "text_4": "Warehouse",
  "text_5": "→ Outpost",
  "text_6": "..trains stopping at the station will collect it as cargo",
  "text_7": "Conversely, packages matching the address will be dropped off",
  "text_8": "Packages that arrived by train can be extracted from the Postbox",
  "text_9": "Warehouse",
  "text_10": "→ Warehouse",
  "text_11": "Just like trains, Postboxes maintain their behaviour in unloaded chunks",
  "text_12": "Packages can still be delivered from or to their inventory"
 },
