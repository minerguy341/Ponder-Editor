{
 "id": "create:high_logistics/redstone_requester",
 "schematic": "high_logistics/redstone_requester",
 "schematicNamespace": "create",
 "title": "Automated orders with Redstone Requesters",
 "texts": {
  "text_1": "Right-click a Stock link before placement to connect to its network",
  "text_2": "Just like Stock tickers, Redstone requesters can order items from the logistics network",
  "text_3": "Right-click the requester to open its configuration UI",
  "text_4": "The order set in the UI will be requested on every redstone pulse",
  "text_5": "Alternatively, the requester can be fully configured before placement",
  "text_6": "Right-click a Stock keeper with it and set the desired order there"
 },
