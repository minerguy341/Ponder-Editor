{
 "id": "create:high_logistics/package_frogport",
 "schematic": "high_logistics/package_frogport",
 "schematicNamespace": "create",
 "title": "Transporting packages between Frogports",
 "texts": {
  "text_1": "Right-click a Chain Conveyor and place the Frogport nearby",
  "text_2": "Assign it an address in the inventory UI",
  "text_3": "If the address of an inserted package does not match it..",
  "text_4": "Albert",
  "text_5": "→ Peter",
  "text_6": "..the Frogport will place the package on the conveyor",
  "text_7": "Packages spin in place if they have no valid destination",
  "text_8": "More Frogports can be added anywhere on the chain network",
  "text_9": "Peter",
  "text_10": "Packages find their path to a matching frog on the chain network",
  "text_11": "Peter",
  "text_12": "→ Peter",
  "text_13": "Frogports can directly interface with inventories below them",
  "text_14": "This also works with packagers. Items can be packed and shipped directly",
  "text_15": "Albert",
  "text_16": "Peter",
  "text_17": "Addresses packages to 'Peter'",
  "text_18": "Right-click Frogports with a clipboard to collect their address",
  "text_19": "Clipboards with collected names can help auto-complete address inputs in other UIs"
 },
