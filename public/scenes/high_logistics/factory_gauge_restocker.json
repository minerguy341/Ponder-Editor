{
 "id": "create:high_logistics/factory_gauge_restocker",
 "schematic": "high_logistics/factory_gauge_restocker",
 "schematicNamespace": "create",
 "title": "Restocking with Factory Gauges",
 "texts": {
  "text_1": "Right-click a Stock link before placement to connect to its network",
  "text_2": "When placed on a packager, factory gauges can monitor items inside the inventory",
  "text_3": "Right-click it with the item that should be monitored",
  "text_4": "It will now display the amount present in the inventory",
  "text_5": "The gauge can refill this inventory from the logistics network",
  "text_6": "Right-click it again to open its configuration UI",
  "text_7": "Set an address that should be used for the requested items",
  "text_8": "The target amount to maintain can now be set by holding Right-click on the gauge",
  "text_9": "Whenever the chest has fewer items than this amount...",
  "text_10": "...the logistics network sends more, with the specified address",
  "text_11": "From there, they can be routed to the packager"
 },
