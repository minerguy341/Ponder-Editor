{
 "id": "create:high_logistics/stock_link",
 "schematic": "high_logistics/stock_link",
 "schematicNamespace": "create",
 "title": "Logistics Networks and the Stock Link",
 "texts": {
  "text_1": "When placed, Stock Links create a new stock network",
  "text_2": "Right-click an existing link before placing it to bind them",
  "text_3": "Stock-linked packagers make their inventory available to the network",
  "text_4": "Other components on the network can now find and request their items",
  "text_5": "On request, items from the inventories will be placed into packages",
  "text_6": "Stock Link signals have unlimited range, but packages require transportation",
  "text_7": "Full redstone power will stop a link from broadcasting",
  "text_8": "Analog power lowers the priority of a link, causing others to act first"
 },
