{
 "id": "create:high_logistics/factory_gauge_links",
 "schematic": "high_logistics/factory_gauge_links",
 "schematicNamespace": "create",
 "title": "Connecting Gauges to other Blocks",
 "texts": {
  "text_1": "When adding a new connection from the UI...",
  "text_2": "...the gauge also accepts Redstone and Display Links",
  "text_3": "Redstone links will be powered when the stock level is at or above the target amount",
  "text_4": "In receiver mode, links can stop the gauge from sending requests",
  "text_5": "Display links can provide a status overview of connected gauges"
 },
