{
 "id": "create:high_logistics/table_cloth",
 "schematic": "high_logistics/table_cloth",
 "schematicNamespace": "create",
 "title": "Selling items with Table Cloths",
 "texts": {
  "text_1": "Table cloths can be used to display items",
  "text_2": "With the help of a logistics system, they can also be used to sell items",
  "text_3": "Start with the shop's inventory, a Packager and Stock link",
  "text_4": "Bind a Stock ticker to the link and place it in the shop",
  "text_5": "Employ a mob or blaze burner as the shop keeper",
  "text_6": "Fill the shop inventory with items to be sold",
  "text_7": "To create a new trade, interact with the shop keeper while holding a table cloth",
  "text_8": "Once placed, set a price in the item slot on the side",
  "text_9": "Other players can now interact with the shop",
  "text_10": "When checking out at the cashier, the bought items will be placed into a package",
  "text_11": "From there, they can be transported to the shop front",
  "text_12": "The payments will be stored inside the stock ticker block"
 },
