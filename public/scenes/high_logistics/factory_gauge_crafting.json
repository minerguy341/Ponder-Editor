{
 "id": "create:high_logistics/factory_gauge_crafting",
 "schematic": "high_logistics/factory_gauge_crafting",
 "schematicNamespace": "create",
 "title": "Automatic Crafting with Factory Gauges",
 "texts": {
  "text_1": "Factory gauges provide auto-arrangement for crafting table recipes",
  "text_2": "Connect the required ingredients as before",
  "text_3": "When a valid recipe is detected, a new button appears in the UI",
  "text_4": "With auto-arrangement active, the boxes can be unwrapped into crafters directly",
  "text_5": "The setup must be 3x3 and the crafters have to be connected via wrench",
  "text_6": "Hold Right-click on the gauge to set the target amount",
  "text_7": "This crafter can now be used universally, by more gauges with different recipes",
  "text_8": "Outputs should be sent back to a linked inventory to close the loop",
  "text_9": "Using a Re-packager is recommended to prevent fragmentation of input packages"
 },
