{
 "id": "create:threshold_switch",
 "schematic": "threshold_switch",
 "schematicNamespace": "create",
 "title": "Monitoring with the Threshold Switch",
 "texts": {
  "text_1": "Threshold Switches monitor the fill level of containers",
  "text_2": "When the inventory content exceeds the upper threshold...",
  "text_3": "...the switch will change its redstone output",
  "text_4": "The signal stays until the lower threshold is reached",
  "text_5": "The redstone output can now be used to control item supply, keeping the buffer filled",
  "text_6": "The specific thresholds can be changed in the UI",
  "text_7": "A filter can help to only count specific contents toward the total",
  "text_8": "Fluid buffers can be monitored in a similar fashion",
  "text_9": "...as well as, curiously, the length of an extended rope pulley"
 },
