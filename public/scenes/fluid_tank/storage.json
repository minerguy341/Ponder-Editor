{
 "id": "create:fluid_tank/storage",
 "schematic": "fluid_tank/storage",
 "schematicNamespace": "create",
 "title": "Storing Fluids in Fluid Tanks",
 "texts": {
  "text_1": "Fluid Tanks can be used to store large amounts of fluid",
  "text_2": "Pipe networks can push and pull fluids from any side",
  "text_3": "The contained fluid can be measured by a Comparator",
  "text_4": "However, in Survival Mode Fluids cannot be added or taken manually",
  "text_5": "You can use Basins, Item Drains and Spouts to drain or fill fluid containing items"
 },
