{
 "id": "create:tunnels/brass",
 "schematic": "tunnels/brass",
 "schematicNamespace": "create",
 "title": "Using Brass Tunnels",
 "texts": {
  "text_1": "Brass Tunnels can be used to cover up your belts",
  "text_2": "Brass Tunnels have filter slots on each open side",
  "text_3": "Filters on inbound connections simply block non-matching items",
  "text_4": "Filters on outbound connections can be used to sort items by type",
  "text_5": "Whenever a passing item has multiple valid exits, the distribution mode will decide how to handle it",
  "text_6": "Brass Tunnels on parallel belts will form a group",
  "text_7": "Incoming Items will now be distributed across all connected exits",
  "text_8": "For this, items can also be inserted into the Tunnel block directly"
 },
