{
 "id": "create:tunnels/brass_modes",
 "schematic": "tunnels/brass_modes",
 "schematicNamespace": "create",
 "title": "Distribution Modes of the Brass Tunnel",
 "texts": {
  "text_1": "The distribution behaviour of Brass Tunnels can be configured",
  "text_2": "'Split' will attempt to distribute the stack evenly between available outputs",
  "text_3": "If an output is unable to take more items, it will be skipped",
  "text_4": "'Forced Split' will never skip outputs, and instead wait until they are free",
  "text_5": "'Round Robin' keeps stacks whole, and cycles through outputs iteratively",
  "text_6": "Once Again, if an output is unable to take more items, it will be skipped",
  "text_7": "'Forced Round Robin' never skips outputs",
  "text_8": "'Prefer Nearest' prioritizes the outputs closest to the items' input location",
  "text_9": "'Randomize' will distribute whole stacks to randomly picked outputs",
  "text_10": "'Synchronize Inputs' is a unique setting for Brass Tunnels",
  "text_11": "Items are only allowed past if every tunnel in the group has one waiting",
  "text_12": "This ensures that all affected belts supply items at the same rate"
 },
