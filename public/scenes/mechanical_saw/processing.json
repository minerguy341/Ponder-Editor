{
 "id": "create:mechanical_saw/processing",
 "schematic": "mechanical_saw/processing",
 "schematicNamespace": "create",
 "title": "Processing Items on the Mechanical Saw",
 "texts": {
  "text_1": "Upward facing Mechanical Saws can process a variety of items",
  "text_2": "The processed item always moves against the rotational input to the saw",
  "text_3": "Saws can work in-line with Mechanical Belts",
  "text_4": "When an ingredient has multiple possible outcomes, the filter slot can specify it",
  "text_5": "Without filter, the Saw would cycle through all outcomes instead"
 },
