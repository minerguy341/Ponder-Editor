 "schematic": "clockwork_bearing",
 "schematicNamespace": "create",
 "title": "Animating Structures using Clockwork Bearings",
 "texts": {
  "text_1": "Clockwork Bearings attach to blocks in front of them",
  "text_2": "Upon receiving Rotational Force, the structure will be rotated according to the hour of the day",
  "text_3": "3:00",
  "text_4": "4:00",
  "text_5": "Right-Click the bearing to start or stop animating the structure",
  "text_6": "In front of the Hour Hand, a second structure can be added",
  "text_7": "Ensure that the two Structures are not glued to each other",
  "text_8": "The Second Structure will now rotate as the Minute Hand"
 },
