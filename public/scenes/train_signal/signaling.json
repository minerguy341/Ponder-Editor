{
 "id": "create:train_signal/signaling",
 "schematic": "train_signal/signaling",
 "schematicNamespace": "create",
 "title": "Collision Prevention with Signals",
 "texts": {
  "text_1": "Train Signals divide a track into segments",
  "text_2": "If a Segment is occupied, no other Trains will be allowed entry",
  "text_3": "Thus, each Segment will contain only one Train at a time",
  "text_4": "A second Signal mode is available via the Wrench",
  "text_5": "Segments of a brass signal usually lead into standard signals",
  "text_6": "This special Signal can stop trains under a second condition",
  "text_7": "It will stop Trains, which, upon entering...",
  "text_8": "...would not be able to leave the Segment immediately",
  "text_9": "This helps keeping queued Trains out of a busy Segment"
 },
 "tags": [],
 "items": [
