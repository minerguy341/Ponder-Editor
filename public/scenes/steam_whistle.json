{
 "id": "create:steam_whistle",
 "schematic": "steam_whistle",
 "schematicNamespace": "create",
 "title": "Setting up Steam Whistles",
 "texts": {
  "text_1": "Steam Whistles can be placed on a Fluid Tank",
  "text_2": "If the tank receives sufficient heat...",
  "text_3": "...the Whistle will play a note when activated",
  "text_4": "Use a Whistle item on the block to lower its pitch",
  "text_5": "Cycle between three different octaves using a Wrench",
  "text_6": "Engineer's Goggles can help to find out the current pitch of a Whistle"
 },
