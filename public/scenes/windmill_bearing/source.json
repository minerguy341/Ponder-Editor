{
 "id": "create:windmill_bearing/source",
 "schematic": "windmill_bearing/source",
 "schematicNamespace": "create",
 "title": "Generating Rotational Force using Windmill Bearings",
 "texts": {
  "text_1": "Windmill Bearings attach to the block in front of them",
  "text_2": "Create a movable structure with the help of Super Glue",
  "text_3": "If enough Sail-like blocks are included, this can act as a Windmill",
  "text_4": "Activated with Right-Click, the Windmill Bearing will start providing Rotational Force",
  "text_5": "The Amount of Sail Blocks determine its Rotation Speed",
  "text_6": "Use the value panel to configure its rotation direction",
  "text_7": "Right-click the Bearing anytime to stop and edit the Structure again"
 },
