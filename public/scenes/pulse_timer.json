 "schematic": "pulse_timer",
 "schematicNamespace": "create",
 "title": "Redstone output of the Pulse Timer",
 "texts": {
  "text_1": "Pulse Timers repeatedly emit short pulses",
  "text_2": "Using the value panel, the time interval can be configured",
  "text_3": "Powering the input side will pause and reset them",
  "text_4": "Right-click the circuit base to invert the output",
  "text_5": "This helps trigger mechanisms that activate only without a redstone signal"
 },
