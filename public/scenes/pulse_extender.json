 "schematic": "pulse_extender",
 "schematicNamespace": "create",
 "title": "Controlling signals using Pulse Extenders",
 "texts": {
  "text_1": "Pulse Extenders can lengthen a signal passing through",
  "text_2": "They activate after a short delay...",
  "text_3": "...and cool down for the configured duration",
  "text_4": "Using the value panel, the discharge time can be configured",
  "text_5": "The configured duration can range up to an hour"
 },
