 "schematicNamespace": "create",
 "title": "Using Mechanical Belts",
 "texts": {
  "text_1": "Right-Clicking two shafts with a belt item will connect them together",
  "text_2": "Accidental selections can be canceled with Right-Click while Sneaking",
  "text_3": "Additional Shafts can be added throughout the Belt",
  "text_4": "Shafts connected via Belts will rotate with Identical Speed and Direction",
  "text_5": "Added shafts can be removed using the wrench",
  "text_6": "Mechanical Belts can be dyed for aesthetic purposes"
 },
