{
 "id": "create:fluid_pipe/flow",
 "schematic": "fluid_pipe/flow",
 "schematicNamespace": "create",
 "title": "Moving Fluids using Copper Pipes",
 "texts": {
  "text_1": "Fluid Pipes can connect two or more fluid sources and targets",
  "text_2": "Using a wrench, a straight pipe segment can be given a window",
  "text_3": "Windowed pipes will not connect to any other adjacent pipe segments",
  "text_4": "Powered by Mechanical Pumps, the Pipes can transport Fluids",
  "text_5": "No fluid is being extracted at first",
  "text_6": "Once the flow connects them, the endpoints gradually transfer their contents",
  "text_7": "Thus, the Pipe blocks themselves never 'physically' contain any fluid"
 },
