{
 "id": "create:weighted_ejector/eject",
 "schematic": "weighted_ejector/eject",
 "schematicNamespace": "create",
 "title": "Using Weighted Ejectors",
 "texts": {
  "text_1": "Sneak and Right-Click holding an Ejector to select its target location",
  "text_2": "The placed ejector will now launch objects to the marked location",
  "text_3": "A valid target can be at any height or distance within range",
  "text_4": "They cannot however be off to a side",
  "text_5": "If no valid Target was selected, it will simply target the block directly in front",
  "text_6": "Supply Rotational Force in order to charge it up",
  "text_7": "Items placed on the ejector cause it to trigger",
  "text_8": "If Inventories are targeted, the ejector will wait until there is space",
  "text_9": "Using the value panel, a required Stack Size can be configured",
  "text_10": "It is now limited to this stack size, and only activates when its held stack reaches this amount",
  "text_11": "Mobs and Players will always trigger an Ejector when stepping on it"
 },
