 "schematicNamespace": "create",
 "title": "Splitting item stacks using Weighted Ejectors",
 "texts": {
  "text_1": "Combined with Brass Tunnels, Ejectors can split item stacks by specific amounts",
  "text_2": "First, configure the Brass Tunnel to 'Prefer Nearest', in order to prioritize its side output",
  "text_3": "The Stack Size set on the Ejector now determines the amount to be split off",
  "text_4": "While a new stack of the configured size exits the side output...",
  "text_5": "...the remainder will continue on its path"
 },
