{
 "id": "create:smart_observer",
 "schematic": "smart_observer",
 "schematicNamespace": "create",
 "title": "Advanced detection with Smart Observers",
 "texts": {
  "text_1": "Smart Observers can be used to detect a variety of events",
  "text_2": "It can detect items or fluids inside of generic containers",
  "text_3": "The filter slot can be used to look for specific contents only",
  "text_4": "It also activates when the block itself matches the filter",
  "text_5": "Additionally, smart observers can monitor belts, chutes and pipes",
  "text_6": "...and will emit a pulse, if an item enters or exits a funnel"
 },
