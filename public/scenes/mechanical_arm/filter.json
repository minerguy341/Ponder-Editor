 "schematic": "mechanical_arm/filter",
 "schematicNamespace": "create",
 "title": "Filtering Outputs of the Mechanical Arm",
 "texts": {
  "text_1": "Inputs",
  "text_2": "Outputs",
  "text_3": "Sometimes it is desirable to restrict targets of the Arm by matching a filter",
  "text_4": "Mechanical Arms by themselves do not provide any options for filtering",
  "text_5": "Brass Funnels as Targets do however communicate their own filter to the Arm",
  "text_6": "The Arm is smart enough not to pick up items it couldn't distribute"
 },
