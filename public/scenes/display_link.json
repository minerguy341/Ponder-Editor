{
 "id": "create:display_link",
 "schematic": "display_link",
 "schematicNamespace": "create",
 "title": "Setting up Display Links",
 "texts": {
  "text_1": "Display Links can be used to visualise dynamic information",
  "text_2": "First, right-click the target display...",
  "text_3": "...then attach it to the block to read from",
  "text_4": "Open the Interface to select and configure what is sent",
  "text_5": "The display will now receive information from the link",
  "text_6": "Not every block can act as a source",
  "text_7": "Each compatible block provides unique information",
  "text_8": "The Display Link can work with several different displays"
 },
