{
 "id": "create:train_track/placement",
 "schematic": "train_track/placement",
 "schematicNamespace": "create",
 "title": "Placing Train Tracks",
 "texts": {
  "text_1": "A new type of rail designed for Train Contraptions",
  "text_2": "To place rows of track in bulk, click on an existing track",
  "text_3": "Then place or select a second track",
  "text_4": "Tracks can also be placed as turns or slopes",
  "text_5": "When connecting, tracks will try to make each turn equally sized",
  "text_6": "Holding the sprint key while connecting...",
  "text_7": "...will create the longest fitting bend instead",
  "text_8": "Materials in the off-hand will be paved under tracks automatically"
 },
