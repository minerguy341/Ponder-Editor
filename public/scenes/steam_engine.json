{
 "id": "create:steam_engine",
 "schematic": "steam_engine",
 "schematicNamespace": "create",
 "title": "Setting up Steam Engines",
 "texts": {
  "text_1": "Steam Engines can be placed on a Fluid Tank",
  "text_2": "Clicking the engine with a Shaft creates the Kinetic Output",
  "text_3": "With sufficient Heat, Water and Boiler space...",
  "text_4": "...they will generate Rotational Force",
  "text_5": "The minimal setup requires 4 Fluid Tanks",
  "text_6": "With the help of Blaze Burners, the power output can be increased",
  "text_7": "Higher power levels require more Water, Size and Heat",
  "text_8": "The boiler's current power level can be inspected with Engineer's Goggles",
  "text_9": "With each added power level, an additional Engine can output at full capacity",
  "text_10": "Lvl 4",
  "text_11": "4 Engines",
  "text_12": "Lvl 8",
  "text_13": "8 Engines"
 },
