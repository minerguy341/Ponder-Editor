{
 "id": "create:train_station/schedule",
 "schematic": "train_station/schedule",
 "schematicNamespace": "create",
 "title": "Stations & Scheduling",
 "texts": {
  "text_1": "Schedules can be used to provide drivers with a destination",
  "text_2": "Comparators will receive a signal whenever a Train is present",
  "text_3": "Mind that a Station can only be approached from the indicated direction",
  "text_4": "Stations can also be used to assign new Schedules automatically",
  "text_5": "The Schedule placed on a station will automatically copy itself to present trains",
  "text_6": "As opposed to manual scheduling, drivers will not take the item with them"
 },
