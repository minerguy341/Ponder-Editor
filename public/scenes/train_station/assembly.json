{
 "id": "create:train_station/assembly",
 "schematic": "train_station/assembly",
 "schematicNamespace": "create",
 "title": "Assembling Trains",
 "texts": {
  "text_1": "Select a Train Track then place the Station nearby",
  "text_2": "Stations are the Waypoints of your Track Network",
  "text_3": "To create a new Train, open the UI and switch to Assembly Mode",
  "text_4": "During Assembly no scheduled trains will approach this station",
  "text_5": "Create new bogeys by using Train Casing on Tracks",
  "text_6": "Click the track again to cycle between bogey designs",
  "text_7": "Attach blocks with the help of Super Glue",
  "text_8": "Assembled Trains will move faster if they can find fuel in assembled chests or barrels",
  "text_9": "Fuel stored in Vaults will not be consumed by the train",
  "text_10": "Every Train requires Train Controls on board",
  "text_11": "An optional second one allows departure from Stations in both directions",
  "text_12": "Open the Station UI and confirm the Assembly process",
  "text_13": "Trains can be disassembled back into blocks at stations only",
  "text_14": "When used on a station, maps will add a labeled marker at the location",
  "text_15": "Assembled Trains can be relocated to nearby Tracks using the Wrench"
 },
