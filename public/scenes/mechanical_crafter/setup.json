{
 "id": "create:mechanical_crafter/setup",
 "schematic": "mechanical_crafter/setup",
 "schematicNamespace": "create",
 "title": "Setting up Mechanical Crafters",
 "texts": {
  "text_1": "An array of Mechanical Crafters can be used to automate any Crafting Recipe",
  "text_2": "Using a Wrench, the Crafters' paths can be arranged",
  "text_3": "For a valid setup, all paths have to converge into one exit at any side",
  "text_4": "The outputs will be placed into the inventory at the exit",
  "text_5": "Mechanical Crafters require Rotational Force to operate",
  "text_6": "Right-Click the front to insert Items manually",
  "text_7": "Once every slot of a path contains an Item, the crafting process will begin",
  "text_8": "For recipes not fully occupying the crafter setup, the start can be forced using a Redstone Pulse"
 },
