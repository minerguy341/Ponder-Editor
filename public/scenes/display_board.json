 "title": "Using Display Boards",
 "texts": {
  "text_1": "Display Boards are a scalable alternative to the sign",
  "text_2": "They require Rotational Force to operate",
  "text_3": "Static text can be applied using written Clipboards",
  "text_4": "And dynamic text through the use of Display Links",
  "text_5": "Dyes can be applied to individual lines of the board",
  "text_6": "Lines can be reset by clicking them with an empty hand"
 },
