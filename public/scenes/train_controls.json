{
 "id": "create:train_controls",
 "schematic": "train_controls",
 "schematicNamespace": "create",
 "title": "Controlling Trains",
 "texts": {
  "text_1": "Train Controls are required on every train contraption",
  "text_2": "Once assembled, right-click the block to start driving",
  "text_3": "Accelerate and steer the Train using movement keybinds",
  "text_4": "If desired, the top speed can be fine-tuned using the mouse wheel",
  "text_5": "Hold space to approach a nearby Station",
  "text_6": "Trains can only be disassembled back into blocks at Stations",
  "text_7": "Assembled Whistles can be activated with the sprint key",
  "text_8": "Sneak or click again to stop controlling the Train"
 },
