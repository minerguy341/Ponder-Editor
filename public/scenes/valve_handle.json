{
 "id": "create:valve_handle",
 "schematic": "valve_handle",
 "schematicNamespace": "create",
 "title": "Precise rotation using Valve Handles",
 "texts": {
  "text_1": "Valve handles can be used to rotate components by a precise angle",
  "text_2": "The angle can be configured on the input panel",
  "text_3": "Right-Click to activate one rotation",
  "text_4": "Sneak-Right-Click to activate it in the opposite direction",
  "text_5": "Mind that Bearings have to be specifically told not to disassemble",
  "text_6": "Valve handles can be dyed for aesthetic purposes"
 },
