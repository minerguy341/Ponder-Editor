{
 "id": "create:contraption_controls",
 "schematic": "contraption_controls",
 "schematicNamespace": "create",
 "title": "Using Contraption Controls",
 "texts": {
  "text_1": "Actors on moving contraptions are always active by default",
  "text_2": "Contraption Controls can be used to toggle them on the fly",
  "text_3": "They can be attached anywhere on the contraption",
  "text_4": "While disassembled, the filter can be changed to target specific types of actors",
  "text_5": "If it is redstone-activated during assembly...",
  "text_6": "...targeted actors will be turned off from the start"
 },
